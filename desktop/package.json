{
  "name": "repoboard-desktop",
  "productName": "RepoBoard",
  "version": "0.7.1",
  "description": "Plan your project inside its repository \u2014 RepoBoard as a desktop app.",
  "author": "NekoFF",
  "homepage": "https://github.com/NekoFF/repoboard",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "main": "main.cjs",
  "scripts": {
    "prepare-server": "node prepare.mjs",
    "start": "electron .",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "com.nekoff.repoboard",
    "productName": "RepoBoard",
    "copyright": "Copyright \u00a9 2026 NekoFF",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "updates.cjs",
      "version.cjs",
      "mcp-home.cjs",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      }
    ],
    "npmRebuild": false,
    "asar": true,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "darkModeSupport": true
    },
    "dmg": {
      "title": "RepoBoard ${version}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "RepoBoard"
    },
    "artifactName": "RepoBoard-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "NekoFF",
        "repo": "repoboard",
        "releaseType": "release"
      }
    ],
    "afterPack": "./after-pack.cjs",
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "executableName": "repoboard",
      "synopsis": "Plan your project inside its repository",
      "maintainer": "NekoFF <NekoFF@users.noreply.github.com>",
      "desktop": {
        "entry": {
          "Name": "RepoBoard",
          "Comment": "Plan your project inside its repository",
          "StartupWMClass": "RepoBoard"
        }
      }
    },
    "appImage": {
      "artifactName": "RepoBoard-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "RepoBoard-${version}-linux-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
