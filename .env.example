# Copy to .env.local. Never commit the real file.

# SQLite file path (local-first, no external DB required)
DATABASE_URL=file:./repoboard.db

# Fine-grained GitHub Personal Access Token (repo contents + metadata read/write,
# pull requests, issues). Generate at https://github.com/settings/tokens?type=beta
# This is the MVP AuthProvider implementation; see lib/github/auth-provider.ts
# for the abstraction point where OAuth / GitHub App would plug in later.
GITHUB_PAT=

# owner/name of the repository RepoBoard manages, e.g. NekoFF/meridian-tv-browser
GITHUB_REPO=
