# Copy to .env.local if you prefer configuring RepoBoard through files.
# Both values are optional: the Settings screen can set them instead, and
# stores the token in .repoboard/credentials.json (mode 0600, gitignored).

# Where the local SQLite database lives.
DATABASE_URL=file:./repoboard.db

# Fine-grained GitHub personal access token, scoped to the one repository you
# want to manage. Create at https://github.com/settings/tokens?type=beta with:
#   Contents        read and write   (read the markdown file, commit moves)
#   Metadata        read             (repository info, default branch)
#   Pull requests   read             (PR list, checks, reviewers)
#   Issues          read             (issue list and labels)
GITHUB_PAT=

# The repository RepoBoard manages, as owner/name.
GITHUB_REPO=
